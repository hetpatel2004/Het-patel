# Client Environment Configuration Template
# Optional: Set this if your backend API is hosted on a different domain (e.g., Vercel frontend + Render backend)
# When left blank or omitted, the frontend automatically defaults to '/api' (ideal for unified deployment)
# Example for split deployment:
# VITE_API_URL=https://het-patel-portfolio-api.onrender.com/api
VITE_API_URL=
